@using MudBlazor
@using Microsoft.JSInterop
@using SqliteToolkit.Demo.Models
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <div @ref="_headerElement" class="dialog-drag-header">
            <MudText Typo="Typo.h6">
                @(Client.Id == 0 ? "Nouveau client" : "Modifier le client")
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">

            <MudTextField @bind-Value="Client.Nom"
                          Label="Nom"
                          Required="true"
                          RequiredError="Le nom est obligatoire."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField @bind-Value="Client.Prenom"
                          Label="Prénom"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField @bind-Value="Client.Email"
                          Label="Email"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField @bind-Value="Client.Telephone"
                          Label="Téléphone"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

        </MudForm>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Annuler"
                   Color="Color.Default">
            Annuler
        </MudButton>

        <MudButton OnClick="Enregistrer"
                   Color="Color.Primary"
                   Variant="Variant.Filled">
            Enregistrer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private IJSObjectReference? _dragModule;
    private IJSObjectReference? _dragInstance;

    private ElementReference _headerElement;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Client Client { get; set; } = new();

    private MudForm _form = null!;

    private async Task Enregistrer()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(Client));
    }

    private void Annuler()
    {
        MudDialog.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dragModule = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/dialog-drag.js");

        _dragInstance = await _dragModule.InvokeAsync<IJSObjectReference>(
            "initialize",
            _headerElement);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragInstance is not null)
        {
            await _dragInstance.InvokeVoidAsync("dispose");
            await _dragInstance.DisposeAsync();
        }

        if (_dragModule is not null)
        {
            await _dragModule.DisposeAsync();
        }
    }
}
