@page "/clients-syncfusion"

@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Grids
@using SqliteToolkit.Demo.Data
@using SqliteToolkit.Demo.Models

@inject ISnackbar Snackbar

<PageTitle>Gestion des clients (Syncfusion)</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <MudText Typo="Typo.h4" Class="mb-4">
        Gestion des clients (Syncfusion)
    </MudText>

    @* Pagination, tris, filtres et recherche sont exécutés en SQL :
       la grille transmet chaque demande à ClientAdaptor, qui la traduit
       en PageRequest. Ajout, modification et suppression passent aussi par lui. *@
    <SfGrid TValue="Client"
            AllowPaging="true"
            AllowSorting="true"
            AllowMultiSorting="true"
            AllowFiltering="true"
            Toolbar="@Toolbar">

        <SfDataManager AdaptorInstance="@typeof(ClientAdaptor)"
                       Adaptor="Syncfusion.Blazor.Adaptors.CustomAdaptor" />

        <GridEvents TValue="Client" OnActionFailure="AfficherErreur" />

        <GridPageSettings PageSize="10" PageSizes="@PageSizes" />

        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />

        <GridEditSettings AllowAdding="true"
                          AllowEditing="true"
                          AllowDeleting="true"
                          ShowDeleteConfirmDialog="true"
                          Mode="Syncfusion.Blazor.Grids.EditMode.Dialog" />

        <GridColumns>

            <GridColumn Field="@nameof(Client.Id)"
                        HeaderText="Id"
                        IsPrimaryKey="true"
                        IsIdentity="true"
                        AllowEditing="false"
                        Width="110" />

            <GridColumn Field="@nameof(Client.Nom)"
                        HeaderText="Nom"
                        ValidationRules="@NomObligatoire" />

            <GridColumn Field="@nameof(Client.Prenom)"
                        HeaderText="Prénom" />

            <GridColumn Field="@nameof(Client.Email)"
                        HeaderText="Email" />

            <GridColumn Field="@nameof(Client.Telephone)"
                        HeaderText="Téléphone"
                        AllowSorting="false"
                        AllowFiltering="false" />

        </GridColumns>

    </SfGrid>

</MudContainer>

@code {

    private static readonly List<string> Toolbar = ["Add", "Edit", "Delete", "Search"];

    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private static readonly ValidationRules NomObligatoire = new() { Required = true };

    private void AfficherErreur(FailureEventArgs args)
    {
        Snackbar.Add(
            $"Erreur : {args.Error?.Message}",
            Severity.Error);
    }

}
