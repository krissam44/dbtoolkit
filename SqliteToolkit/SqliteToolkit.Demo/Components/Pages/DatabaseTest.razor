@page "/database-test"
@using SqliteToolkit.Demo.Data
@using SqliteToolkit.Demo.Services 
@inject DatabaseConnectionTestService DbTest

<PageTitle>Test SQLite</PageTitle>

<h3>Test de connexion SQLite</h3>

<p>@_connectionMessage</p>

<MudDivider Class="my-4" />

<h4>Test de gestion des erreurs</h4>

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="TestRepositoryError"
           Disabled="_testing">
    @(_testing ? "Test en cours..." : "Tester la gestion des erreurs")
</MudButton>

<MudButton Variant="Variant.Filled"
           Color="Color.Warning"
           OnClick="TestViolationContrainte"
           Disabled="_testing">
    Tester la contrainte NOT NULL
</MudButton>

<MudButton Variant="Variant.Filled"
           Color="Color.Info"
           OnClick="TestCancellation"
           Disabled="_testing">
    Tester l'annulation
</MudButton>

<MudButton Variant="Variant.Filled"
           Color="Color.Success"
           OnClick="TestCommit"
           Disabled="_testing">
    Tester le Commit
</MudButton>

<MudButton Variant="Variant.Filled"
           Color="Color.Warning"
           OnClick="TestRollback"
           Disabled="_testing">
    Tester le Rollback
</MudButton>

@if (_errorMessage is not null)
{
    <MudAlert Severity="@_errorSeverity" Class="mt-3">
        @_errorMessage
    </MudAlert>
}

@code {
    private string? _connectionMessage;
    private string? _errorMessage;
    private Severity _errorSeverity = Severity.Info;
    private bool _testing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _connectionMessage = await DbTest.TestConnectionAsync();
        }
        catch (Exception ex)
        {
            _connectionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task TestRepositoryError()
    {
        _testing = true;
        _errorMessage = null;

        try
        {
            var result = await DbTest.TestRepositoryErrorAsync();

            _errorMessage = result;
            _errorSeverity = result.StartsWith("Test réussi")
                ? Severity.Success
                : Severity.Error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur inattendue : {ex.Message}";
            _errorSeverity = Severity.Error;
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestViolationContrainte()
    {
        _testing = true;
        _errorMessage = null;

        try
        {
            var result = await DbTest.TestViolationContrainteAsync();

            _errorMessage = result;
            _errorSeverity = result.StartsWith("Test réussi")
                ? Severity.Success
                : Severity.Error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur inattendue : {ex.Message}";
            _errorSeverity = Severity.Error;
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestCancellation()
    {
        _testing = true;
        _errorMessage = null;

        try
        {
            var result = await DbTest.TestCancellationAsync();

            _errorMessage = result;
            _errorSeverity = result.StartsWith("Test réussi")
                ? Severity.Success
                : Severity.Error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur inattendue : {ex.Message}";
            _errorSeverity = Severity.Error;
        }
        finally
        {
            _testing = false;
        }
    }

    [Inject]
    private UnitOfWorkTestService UnitOfWorkTest { get; set; } = null!;

    private async Task TestCommit()
    {
        _testing = true;
        _errorMessage = null;

        try
        {
            var result = await UnitOfWorkTest.TestCommitAsync();

            _errorMessage = result;
            _errorSeverity = result.StartsWith("Test réussi")
                ? Severity.Success
                : Severity.Error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur inattendue : {ex.Message}";
            _errorSeverity = Severity.Error;
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestRollback()
    {
        _testing = true;
        _errorMessage = null;

        try
        {
            var result = await UnitOfWorkTest.TestRollbackAsync();

            _errorMessage = result;
            _errorSeverity = result.StartsWith("Test réussi")
                ? Severity.Success
                : Severity.Error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur inattendue : {ex.Message}";
            _errorSeverity = Severity.Error;
        }
        finally
        {
            _testing = false;
        }
    }

}
