<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>947af334-9048-412b-963e-a859655bedc6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\Sql\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="35.1.46" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqliteToolkit\SqliteToolkit.csproj" />
    <ProjectReference Include="..\SqliteToolkit.Adapters.AspNetCore\SqliteToolkit.Adapters.AspNetCore.csproj" />
    <ProjectReference Include="..\SqliteToolkit.Adapters.MudBlazor\SqliteToolkit.Adapters.MudBlazor.csproj" />
    <ProjectReference Include="..\SqliteToolkit.Adapters.Syncfusion\SqliteToolkit.Adapters.Syncfusion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
